/* Arsenic from averaged peak current, in ug/L (same calibration as the server). */
/* Calibration in use (v5.6): the factory numbers above until the server sends one made for this node
 * or its electrode batch (GET /api/devices/<code>/calibration). Kept in flash across restarts. */
volatile float cal_slope = CAL_SLOPE_UA_PER_MGL;
volatile float cal_icpt  = CAL_INTERCEPT_UA;
char cal_id[48] = "factory";
volatile uint16_t cal_tag_now = 0;           // CRC-16 of cal_id, 0 = factory

static uint16_t crc16(const char* s) {
    uint16_t c = 0xFFFF;
    for (; *s; s++) {
        c ^= (uint16_t)(uint8_t)*s << 8;
        for (int i = 0; i < 8; i++) c = (c & 0x8000) ? (uint16_t)((c << 1) ^ 0x1021) : (uint16_t)(c << 1);
    }
    return c ? c : 1;                        // never 0: 0 means factory
}

static float arsenic_ug_from_peak(float peak_ua) {
    float slope = cal_slope, icpt = cal_icpt;
    return peak_ua > icpt ? (peak_ua - icpt) / slope * 1000.0f : 0.0f;
}

/* True if an arsenic estimate from n scans could plausibly be on the other side of a verdict edge:
 * 10 ug/L (IS 10500 / WHO limit), 20 ug/L (sensor LOD: above it = detected = Unsafe) or 150 ug/L (Hazardous).
 * Single-scan noise follows app/standards.py: 5 ug/L below 50, 7.5 up to 150, 15 above. */
static bool arsenic_near_limit(float ug, int n_scans) {
    static const float limits[3] = {10.0f, 20.0f, 150.0f};
    float sd = (ug < 50.0f ? 5.0f : (ug <= 150.0f ? 7.5f : 15.0f)) / sqrtf((float)n_scans);
    for (int i = 0; i < 3; i++)
        if (fabsf(ug - limits[i]) < RESCAN_Z * sd) return true;
    return false;
}

