/* Low-power mode: deep sleep (about 10 uA for the chip) between tests instead of staying awake.
 * After each test the node stays awake up to LOW_POWER_AWAKE_MS to upload it and any buffered
 * readings, then sleeps until the next test. The status and setup pages are only reachable while it
 * is awake, and the node never sleeps while the setup hotspot is open.
 * Wiring: fit a 10k pull-up from the A4988 EN pin to 3.3 V. Carrier boards such as Pololu's pull
 * EN low with 100k (driver ON by default), so a floating EN would switch the motor coils on and drain
 * the battery. The firmware also holds EN high through deep sleep. */
#ifndef LOW_POWER_MODE
#define LOW_POWER_MODE 0
#endif
#ifndef LOW_POWER_AWAKE_MS
#define LOW_POWER_AWAKE_MS 90000UL
#endif

/* On ESP32-C3 / S3 a held output stays held in deep sleep only after gpio_deep_sleep_hold_en(). */
#if defined(SOC_GPIO_SUPPORT_HOLD_IO_IN_DSLP) && SOC_GPIO_SUPPORT_HOLD_IO_IN_DSLP && \
    !(defined(SOC_GPIO_SUPPORT_HOLD_SINGLE_IO_IN_DSLP) && SOC_GPIO_SUPPORT_HOLD_SINGLE_IO_IN_DSLP)
  #define NEED_DEEP_SLEEP_HOLD 1
#else
  #define NEED_DEEP_SLEEP_HOLD 0
#endif

/* Arsenic from averaged peak current, in ug/L (same calibration as the server). */
static float arsenic_ug_from_peak(float peak_ua) {
    return peak_ua > CAL_INTERCEPT_UA ? (peak_ua - CAL_INTERCEPT_UA) / CAL_SLOPE_UA_PER_MGL * 1000.0f : 0.0f;
}

/* True if an arsenic estimate from n scans could plausibly be on the other side of a verdict edge:
 * 10 ug/L (IS 10500 / WHO limit), 20 ug/L (sensor LOD: above it = detected = Unsafe) or 150 ug/L (Hazardous).
 * Single-scan noise follows app/standards.py: 5 ug/L below 50, 7.5 up to 150, 15 above. */
static bool arsenic_near_limit(float ug, int n_scans) {
    static const float limits[3] = {10.0f, 20.0f, 150.0f};
    float sd = (ug < 50.0f ? 5.0f : (ug <= 150.0f ? 7.5f : 15.0f)) / sqrtf((float)n_scans);
    for (int i = 0; i < 3; i++)
        if (fabsf(ug - limits[i]) < RESCAN_Z * sd) return true;
    return false;
}

