/* Setup is allowed on the hotspot (protected by its own password) or, on your network,
 * with the OTA login once OTA_PASS has been changed. */
static bool setup_allowed() {
    if (setup_ap_active && WiFi.softAPgetStationNum() > 0 && server.client().localIP() == WiFi.softAPIP()) return true;
    if (!ota_enabled()) return false;
    return server.authenticate(OTA_USER, OTA_PASS);
}

