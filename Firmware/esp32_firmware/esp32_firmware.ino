/* Total arsenic (v5.6). Arsenic in groundwater is a mix of As(III) and As(V). In raw water the gold
 * electrode only sees As(III): As(V) is electrochemically inactive until the sample is acidified with
 * a reducing supporting electrolyte (for example the sulfamic acid / citric acid / KCl mixture used by
 * Metrohm's method). Without that step the node reports "As(III) only" and the server warns that the
 * result can be too low. With a small dosing pump (MOSFET-switched) on PIN_REAGENT_PUMP the node adds
 * the electrolyte after the other sensors are read, waits REAGENT_MIX_MS, then measures total arsenic.
 * Bench-test the dose, mixing time and deposition potential with As(V) standards before field use. */
#ifndef PIN_REAGENT_PUMP
#define PIN_REAGENT_PUMP     -1
#endif
#ifndef REAGENT_PUMP_MS
#define REAGENT_PUMP_MS      1500UL
#endif
#ifndef REAGENT_MIX_MS
#define REAGENT_MIX_MS       30000UL
#endif

