void handle_setup_get() {
    if (!setup_allowed()) {
        if (!ota_enabled() && !setup_ap_active) return server.send(403, "text/plain", "Settings on the network are disabled until OTA_PASS is changed. Use the setup hotspot instead.");
        return server.requestAuthentication();
    }
    String h = "<!DOCTYPE html><html><head><title>AquaSentry setup</title>";
    h += PAGE_STYLE;
    h += "</head><body><form class='card' method='POST' action='/setup'><h2>AquaSentry setup</h2>"
         "<label>Wi-Fi name</label><input name='ssid' maxlength='32' required value='";
    h += wifi_configured() ? html_escape(WIFI_SSID) : String("");
    h += "'><label>Wi-Fi password</label><input name='pass' type='password' maxlength='64' placeholder='leave empty to keep the current one'>"
         "<label>Server address</label><input name='url' maxlength='160' required value='";
    h += html_escape(BACKEND_API_URL);
    h += "'><p class='muted'>Like http://192.168.1.20:8000/api/readings (start the server with --host 0.0.0.0)</p>"
         "<label>Device name</label><input name='dev' maxlength='32' required pattern='[A-Za-z0-9_-]{2,32}' value='";
    h += html_escape(DEVICE_CODE);
    h += "'><label>Server API key</label><input name='key' type='password' maxlength='72' placeholder='";
    h += DEVICE_API_KEY[0] ? "set - leave empty to keep it" : "only if the server sets AQUASENTRY_API_KEY";
    h += "'><button type='submit'>Save and restart</button></form></body></html>";
    server.send(200, "text/html", h);
}

void handle_setup_post() {
    if (!setup_allowed()) return server.requestAuthentication();
    String ssid = server.arg("ssid"), pass = server.arg("pass"), url = server.arg("url");
    String dev = server.arg("dev"), key = server.arg("key");
    ssid.trim(); url.trim(); dev.trim(); key.trim();
    bool url_ok = url.startsWith("http://") || url.startsWith("https://");
    bool dev_ok = dev.length() >= 2 && dev.length() <= 32;
    for (size_t i = 0; dev_ok && i < dev.length(); i++) { char c = dev[i]; dev_ok = isalnum((unsigned char)c) || c == '-' || c == '_'; }
    if (ssid.length() == 0 || ssid.length() > 32 || pass.length() > 64 || !url_ok || url.length() > 160 || !dev_ok || key.length() > 72)
        return server.send(400, "text/plain", "Check the values: Wi-Fi name 1-32 characters, server address starting with http://, device name 2-32 letters/digits/-/_.");
    Preferences p;
    p.begin("aqcfg", false);
    p.putString("ssid", ssid);
    if (pass.length() > 0) p.putString("pass", pass);
    p.putString("url", url);
    p.putString("dev", dev);
    if (key.length() > 0) p.putString("key", key);
    p.end();
    server.send(200, "text/html", String("<!DOCTYPE html><html><head>") + PAGE_STYLE +
        "</head><body><div class='card'><h2>Saved</h2><p>The node restarts now and joins your Wi-Fi.</p></div></body></html>");
    delay(1200);
    ESP.restart();
}

/* v5.7: /qc - run a blank (arsenic-free water) or a check standard (a known arsenic solution). The server
 * only trusts this node's LOW readings after a passing check standard in the last 7 days. */
void handle_qc_get() {
    if (!setup_allowed()) return server.requestAuthentication();
    String h = String("<!DOCTYPE html><html><head><title>AquaSentry quality check</title>") + PAGE_STYLE +
        "</head><body><form class='card' method='POST' action='/qc'><h2>Quality check</h2>"
        "<p class='muted'>Put the solution in the sample chamber first. A check standard is a solution with a known "
        "arsenic level (for example 50 &micro;g/L); it must read within 80-120 %. Run one at least once a week, "
        "or the server reports low readings from this node as <b>Test failed</b>.</p>"
        "<label><input type='radio' name='type' value='2' checked> Check standard</label> "
        "<label><input type='radio' name='type' value='1'> Blank (arsenic-free water)</label>"
        "<label>Known arsenic level of the check standard (&micro;g/L)<input name='expected' type='number' min='1' max='1000' step='0.1' value='50'></label>"
        "<button type='submit'>Start (takes about 4 minutes)</button></form>";
    if (qc_done) h += "<p class='card muted'>Last run is waiting to be sent to the server.</p>";
    h += "</body></html>";
    server.send(200, "text/html", h);
}

void handle_qc_post() {
    if (!setup_allowed()) return server.requestAuthentication();
    int type = atoi(server.arg("type").c_str());
    float expected = (float)atof(server.arg("expected").c_str());
    if (type != 1 && type != 2) return server.send(400, "text/plain", "Choose blank or check standard.");
    if (type == 2 && !(expected > 0.0f && expected <= 1000.0f)) return server.send(400, "text/plain", "Enter the known arsenic level (1-1000 ug/L).");
    qc_request_expected = expected;
    qc_request = type;
    server.send(200, "text/html", String("<!DOCTYPE html><html><head><title>Quality check started</title>") + PAGE_STYLE +
        "</head><body><div class='card'><h2>Quality check queued</h2><p>It starts within a few seconds (after any test "
        "already running) and the result is sent to the server. See the serial monitor or the dashboard.</p>"
        "<p><a href='/'>Back</a></p></div></body></html>");
}

void setup_webserver() {
    server.on("/", HTTP_GET, handle_root);
    server.on("/qc", HTTP_GET, handle_qc_get);
    server.on("/qc", HTTP_POST, handle_qc_post);
    server.on("/status.json", HTTP_GET, handle_status_json);
    server.on("/setup", HTTP_GET, handle_setup_get);
    server.on("/setup", HTTP_POST, handle_setup_post);

    server.on("/update", HTTP_GET, []() {
        if (!ota_enabled()) return server.send(403, "text/plain", "OTA disabled: set OTA_PASS (8+ characters) in the firmware first.");
        if (!server.authenticate(OTA_USER, OTA_PASS)) return server.requestAuthentication();
        server.send(200, "text/html", String("<!DOCTYPE html><html><head><title>AquaSentry firmware update</title>") + PAGE_STYLE +
            "</head><body><form class='card' method='POST' action='/update' enctype='multipart/form-data'>"
            "<h2>Firmware update</h2><p class='muted'>Choose the compiled .bin file (Sketch &rarr; Export Compiled Binary).</p>"
            "<input type='file' name='update' accept='.bin' required><button type='submit'>Upload and restart</button></form></body></html>");
    });

    server.on("/update", HTTP_POST, []() {
        if (!ota_enabled()) return server.send(403, "text/plain", "OTA disabled");
        if (!server.authenticate(OTA_USER, OTA_PASS)) return server.requestAuthentication();
        server.sendHeader("Connection", "close");
        server.send(200, "text/plain", (Update.hasError()) ? "OTA UPDATE FAILED" : "OTA UPDATE SUCCESSFUL - REBOOTING...");
        delay(1000);
        if (!Update.hasError()) ESP.restart();
    }, []() {
        if (!ota_enabled() || !server.authenticate(OTA_USER, OTA_PASS)) return;   // no default-password flashing
        HTTPUpload& upload = server.upload();
        if (upload.status == UPLOAD_FILE_START) {
            Serial.printf("[OTA] Update Start: %s\n", upload.filename.c_str());
            if (!Update.begin(UPDATE_SIZE_UNKNOWN)) {
                Update.printError(Serial);
            }
        } else if (upload.status == UPLOAD_FILE_WRITE) {
            if (Update.write(upload.buf, upload.currentSize) != upload.currentSize) {
                Update.printError(Serial);
            }
        } else if (upload.status == UPLOAD_FILE_END) {
            if (Update.end(true)) {
                Serial.printf("[OTA] Success: %lu bytes written.\n", (unsigned long)upload.totalSize);
            } else {
                Update.printError(Serial);
            }
        }
    });

    server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });
    server.begin();
    Serial.println(F("[WEB] Web server on port 80: /  /status.json  /setup  /update"));
}

/* =====================================================================
 * Telemetry task (core 0): Wi-Fi, setup hotspot, web pages, uploads, offline buffer
 * ===================================================================== */
/* v5.7: send a finished blank / check-standard run to the server. Returns true when it is stored. */
bool post_qc_run() {
    HTTPClient http;
    http.setTimeout(8000);
    WiFiClient plain;
    WiFiClientSecure secure;
    if (backend_is_https() && !ROOT_CA_PEM[0] && !ALLOW_INSECURE_TLS) return false;
    if (!http_start(http, plain, secure, server_base() + "/api/qc/runs")) return false;
    http.addHeader("Content-Type", "application/json");
    if (DEVICE_API_KEY[0]) http.addHeader("X-API-Key", DEVICE_API_KEY);
    char body[400];
    int n = snprintf(body, sizeof(body), "{\"device_code\":\"%s\",\"run_type\":\"%s\",\"peak_current_ua\":%.4f",
                     DEVICE_CODE, qc_done_type == 1 ? "blank" : "check_standard", qc_done_peak);
    if (qc_done_type == 2) n += snprintf(body + n, sizeof(body) - n, ",\"expected_ug_l\":%.2f", qc_done_expected);
    int k = 0;
    for (size_t i = 0; i < sizeof(QC_NAMES) / sizeof(QC_NAMES[0]); i++)
        if (qc_done_bits & QC_NAMES[i].bit)
            n += snprintf(body + n, sizeof(body) - n, "%s\"%s\"", k++ ? "," : ",\"qc_scan_flags\":[", QC_NAMES[i].name);
    if (k) n += snprintf(body + n, sizeof(body) - n, "]");
    snprintf(body + n, sizeof(body) - n, "}");
    int code = http.POST(body);
    String resp = http.getString();
    http.end();
    Serial.printf("[QC] Server answer (HTTP %d): %s\n", code, resp.c_str());
    return code >= 200 && code < 300;
}

/* v5.8: upload the stored last scan of reading `trace_seq` as evidence (POST /api/scans, attached to the reading by
 * its idempotency key). Returns 1 = stored, 0 = try again later (offline, or the reading itself is not stored yet),
 * -1 = rejected for good. The reading is never delayed by this: it is sent first, the trace afterwards. */
static char trace_body[ASV_MAX_POINTS * 18 + 320];
int post_trace() {
    if (!trace_pending || trace_n < 10) return -1;
    HTTPClient http;
    http.setTimeout(10000);
    WiFiClient plain;
    WiFiClientSecure secure;
    if (backend_is_https() && !ROOT_CA_PEM[0] && !ALLOW_INSECURE_TLS) return 0;
    if (!http_start(http, plain, secure, server_base() + "/api/scans")) return 0;
    http.addHeader("Content-Type", "application/json");
    if (DEVICE_API_KEY[0]) http.addHeader("X-API-Key", DEVICE_API_KEY);
    const size_t cap = sizeof(trace_body);
    int n = snprintf(trace_body, cap, "{\"device_code\":\"%s\",\"source_type\":\"hardware\",\"firmware_version\":\"%s\","
                     "\"reading_idempotency_key\":\"%s-%lu\",\"idempotency_key\":\"%s-%lu-trace\"",
                     DEVICE_CODE, FIRMWARE_VERSION, DEVICE_CODE, (unsigned long)trace_seq, DEVICE_CODE, (unsigned long)trace_seq);
    if (trace_utc > 1700000000UL) {
        time_t t = (time_t)trace_utc; struct tm tm_utc; gmtime_r(&t, &tm_utc);
        char iso[32]; strftime(iso, sizeof(iso), "%Y-%m-%dT%H:%M:%SZ", &tm_utc);
        n += snprintf(trace_body + n, cap - n, ",\"recorded_at\":\"%s\"", iso);
    }
    n += snprintf(trace_body + n, cap - n, ",\"scan_settings\":{\"deposition_mv\":%.0f,\"deposition_s\":%d,\"step_mv\":%.1f,\"step_ms\":%d,\"clean_mv\":%.0f}",
                  VOLT_DEP_MV, VOLT_DEP_TIME_MS / 1000, VOLT_STEP_MV, VOLT_STEP_WAIT_MS, VOLT_CLEAN_MV);
    n += snprintf(trace_body + n, cap - n, ",\"potentials_mv\":[");
    for (int i = 0; i < trace_n && n < (int)cap - 40; i++) n += snprintf(trace_body + n, cap - n, "%s%.1f", i ? "," : "", trace_pot[i]);
    n += snprintf(trace_body + n, cap - n, "],\"currents_ua\":[");
    for (int i = 0; i < trace_n && n < (int)cap - 20; i++) n += snprintf(trace_body + n, cap - n, "%s%.5f", i ? "," : "", trace_cur[i]);
    n += snprintf(trace_body + n, cap - n, "]}");
    if (n >= (int)cap - 2) { Serial.println(F("[TRACE] Scan too long for the upload buffer - not sent.")); return -1; }
    int code = http.POST(trace_body);
    http.end();
    if (code >= 200 && code < 300) { Serial.printf("[TRACE] Scan of reading #%lu stored as evidence.\n", (unsigned long)trace_seq); return 1; }
    if (code == 404) return 0;                        // the reading is still in the offline buffer: send the trace after it
    if (code >= 400 && code < 500 && code != 408 && code != 429) {
        Serial.printf("[TRACE] Scan of reading #%lu rejected (HTTP %d) - dropped.\n", (unsigned long)trace_seq, code);
        return -1;
    }
    return 0;
}

void TaskTelemetry(void *pvParameters) {
    (void) pvParameters;

    WiFi.mode(WIFI_STA);
    WiFi.setAutoReconnect(true);
    make_setup_ap_credentials();
    if (wifi_configured()) {
        WiFi.begin(WIFI_SSID, WIFI_PASS);
        Serial.printf("[WIFI] Connecting to \"%s\"...\n", WIFI_SSID);
    } else {
        Serial.println(F("[WIFI] No Wi-Fi saved yet - opening the setup hotspot."));
        start_setup_ap();
    }
    setup_webserver();

    uint32_t boot_ms = millis(), last_sync = 0;
    for (;;) {
        server.handleClient();

        if (WiFi.status() == WL_CONNECTED) {
            if (!is_wifi_connected) {
                is_wifi_connected = true;
                Serial.printf("[WIFI] Connected! Node IP: %s  (status page: http://%s/)\n",
                              WiFi.localIP().toString().c_str(), WiFi.localIP().toString().c_str());
                configTime(0, 0, "pool.ntp.org", "time.google.com");   // UTC clock for sample timestamps
                last_sync = millis() - 25000;                           // flush the buffer ~5 s after connecting
            }
        } else {
            if (is_wifi_connected) Serial.println(F("[WIFI] Connection lost - readings will be buffered."));
            is_wifi_connected = false;
            if (!setup_ap_active && millis() - boot_ms > SETUP_AP_AFTER_MS) {
                Serial.println(F("[WIFI] Could not join Wi-Fi - opening the setup hotspot (measuring continues)."));
                start_setup_ap();
            }
        }

        // Readings from the sensor task
        sensor_reading_t r;
        if (xQueueReceive(readingQueue, &r, 10 / portTICK_PERIOD_MS) == pdTRUE) {
            is_uploading = true;
            int res = is_wifi_connected ? post_reading(&r) : 0;
            if (res == 1) {
                Serial.println(F("[HTTP] Ingested successfully"));
                if (TRACE_UPLOAD && trace_pending && trace_seq == r.seq && post_trace() != 0) trace_pending = false;
            } else if (res == 0) {
                // server not reachable (check IP, --host 0.0.0.0, firewall) or Wi-Fi down
                offline_push(&r);
            }
            is_uploading = false;
        }

        // v5.7: a finished blank / check-standard run
        if (qc_done && is_wifi_connected) {
            is_uploading = true;
            if (post_qc_run()) qc_done = false;
            is_uploading = false;
        }

        // Upload buffered readings every 30 seconds while online; then the pending scan evidence (v5.8)
        if (is_wifi_connected && (millis() - last_sync > 30000UL)) {
            is_uploading = true;
            offline_flush();
            if (TRACE_UPLOAD && trace_pending && offline_count() == 0) {
                if (post_trace() != 0) trace_pending = false;
            }
            is_uploading = false;
            last_sync = millis();
        }

        // Daily: this node's calibration, and (if PULL_OTA) a newer firmware build from the server.
        // RTC memory keeps the times through deep sleep, so low-power nodes do not ask on every wake.
        if (is_wifi_connected && millis() - boot_ms > 10000UL) {
            uint32_t now_s = utc_now_or_zero();
            if (due_daily(&last_cal_check, now_s, CALIBRATION_CHECK_HOURS)) {
                is_uploading = true;
                fetch_calibration();
                is_uploading = false;
            }
            if (PULL_OTA && due_daily(&last_update_check, now_s, UPDATE_CHECK_HOURS)) check_server_update();
        }

        vTaskDelay(10 / portTICK_PERIOD_MS);
    }
}

/* =====================================================================
 * Low-power mode: deep sleep until the next test
 * ===================================================================== */
void enter_deep_sleep(uint32_t sleep_ms) {
    dac_set_potential(0.0f);                      // electrode at rest (0 mV), not at a deposition potential
    digitalWrite(PIN_STEPPER_ENABLE, HIGH);       // A4988 off ...
    gpio_hold_en((gpio_num_t)PIN_STEPPER_ENABLE); // ... and kept off while the chip sleeps
    const int reagent_pin = PIN_REAGENT_PUMP;
    if (reagent_pin >= 0) { digitalWrite((uint8_t)reagent_pin, LOW); gpio_hold_en((gpio_num_t)reagent_pin); }
#if NEED_DEEP_SLEEP_HOLD
    gpio_deep_sleep_hold_en();
#endif
    digitalWrite(PIN_STATUS_LED, LOW);
    Serial.printf("[POWER] Deep sleep for %lu s (wake %lu).\n", (unsigned long)(sleep_ms / 1000), (unsigned long)wake_count);
    Serial.flush();
    WiFi.disconnect(true);
    WiFi.mode(WIFI_OFF);
    esp_sleep_enable_timer_wakeup((uint64_t)sleep_ms * 1000ULL);
    esp_deep_sleep_start();
}

/* After a test: wait until the telemetry task has uploaded it (and, if online, the offline backlog),
 * at most LOW_POWER_AWAKE_MS, then sleep for the rest of the interval. */
void low_power_sleep_after_test(uint32_t cycle_start_ms) {
    if (setup_ap_active || !wifi_configured()) {
        Serial.println(F("[POWER] Setup hotspot open - staying awake instead of sleeping."));
        return;
    }
    uint32_t t0 = millis();
    while (millis() - t0 < LOW_POWER_AWAKE_MS &&
           (uxQueueMessagesWaiting(readingQueue) > 0 || is_uploading || (is_wifi_connected && offline_count() > 0)))
        vTaskDelay(250 / portTICK_PERIOD_MS);
    uint32_t spent = millis() - cycle_start_ms;
    enter_deep_sleep(spent < SAMPLE_INTERVAL_MS ? SAMPLE_INTERVAL_MS - spent : 60000UL);
}

/* =====================================================================
 * Sensor task (core 1, or core 0 on single-core chips): pump, scans, AquaNet-V3
 * ===================================================================== */
/* v5.7: measure a blank or a check standard that the operator has put in the sample cup / chamber.
 * Same scans and checks as a normal test; the result goes to the server, which then trusts (or stops
 * trusting) this node's low readings. A drifting or dying electrode is caught here before it can make
 * contaminated water look clean. */
void run_qc_measurement() {
    int type = qc_request;
    float expected = qc_request_expected;
    qc_request = 0;
    is_measuring = true;
    Serial.printf("[QC] %s run requested%s\n", type == 1 ? "Blank" : "Check-standard", type == 2 ? "" : "");
    pump_purge_and_relax(3200);
    uint16_t bits = 0;
    int good = 0;
    float sum = 0.0f;
    if (!check_chamber_liquid_presence()) bits |= QC_FLAT_SIGNAL;   // nothing to measure
    else {
        for (int s = 0; s < SCANS_PER_READING; s++) {
            asv_result_t one = execute_asv_cycle();
            bits |= one.qc;
            if (one.points >= 10 && !(one.qc & QC_FAULT_MASK)) { sum += one.net_peak_ua; good++; }
        }
    }
    if (good < QC_MIN_GOOD_SCANS) bits |= QC_TOO_FEW_SCANS;
    qc_done_type = type;
    qc_done_expected = expected;
    qc_done_peak = good ? sum / good : 0.0f;
    qc_done_bits = bits;
    qc_done_scans = good;
    qc_done = true;
    is_measuring = false;
    Serial.printf("[QC] Done: peak %.4f uA from %d good scan(s), bits 0x%04X\n", qc_done_peak, good, bits);
}

void TaskSensors(void *pvParameters) {
    (void) pvParameters;

    for (;;) {
        // Run one full test cycle, then wait (or deep-sleep in low-power mode) SAMPLE_INTERVAL_MS (1 hour)
        uint32_t cycle_start = millis();
        is_measuring = true;
        digitalWrite(PIN_STATUS_LED, HIGH);
        int battery = read_battery_pct();         // before the pump loads the battery
        last_battery_pct = battery;

        // 1. Check I2C bus health
        Wire.beginTransmission(ADS1115_ADDR);
        if (Wire.endTransmission() != 0) {
            Serial.println(F("[I2C] Bus error detected on ADS1115 probe."));
            recover_i2c_bus();
        }

        // 2. Sample Intake and Purge with Tubing Anti-Set Relaxation (Imp 26)
        pump_purge_and_relax(3200);

        // 3. Optical Dry-Run / Bubble Gate (Imp 27)
        if (!check_chamber_liquid_presence()) {
            Serial.println(F("[SAFETY] Chamber bubble detected. Attempting re-prime..."));
            step_pump(1600, true, 500);
            delay(500);
            if (!check_chamber_liquid_presence()) {
                Serial.println(F("[SAFETY] ABORTING ASV: Liquid presence cannot be confirmed."));
                digitalWrite(PIN_STATUS_LED, LOW);
                is_measuring = false;
                vTaskDelay(60000 / portTICK_PERIOD_MS); // Retry in 1 min
                continue;
            }
        }

        // 4. Auxiliary sensors. NAN = sensor not fitted (not sent to the server).
        float temp = read_temperature();
        float ph = read_ph();
        float ec = read_conductivity(temp);
        float turb = read_turbidity();
        if (isnan(ph) && isnan(ec) && isnan(turb) && isnan(temp)) {
            Serial.println(F("[SENSORS] pH / conductivity / turbidity / temperature not fitted - sending arsenic only."));
        }

        // 4b. Total arsenic: dose the acid / reducing electrolyte AFTER the other sensors (it changes pH and
        //     conductivity), so As(V) becomes measurable. Without a reagent pump the node sees As(III) only.
        const int reagent_pin = PIN_REAGENT_PUMP;
        if (reagent_pin >= 0) {
            Serial.println(F("[ASV] Dosing electrolyte for total arsenic..."));
            digitalWrite((uint8_t)reagent_pin, HIGH);
            vTaskDelay(REAGENT_PUMP_MS / portTICK_PERIOD_MS);
            digitalWrite((uint8_t)reagent_pin, LOW);
            vTaskDelay(REAGENT_MIX_MS / portTICK_PERIOD_MS);
        }

        // 5. ASV sweeps with cleaning pulse, smoothing and background removal (Imp 7, 8).
        //    Several scans are averaged: random noise falls by sqrt(number of scans).
        //    Adaptive re-scan: start with SCANS_PER_READING scans; while the arsenic estimate is within
        //    RESCAN_Z standard errors of a verdict edge (10 / 20 / 150 ug/L), add SCANS_PER_READING more, up to
        //    MAX_SCANS_PER_READING. Clear readings stay fast; only borderline ones get the extra scans.
        asv_result_t asv = {0.0f, PEAK_CENTER_MV, 0.0f, 0, NAN, 0};
        int good_scans = 0, attempts = 0, cu_scans = 0, last_scan_points = 0;
        float peak_sum = 0.0f, snr_sum = 0.0f, cu_sum = 0.0f;
        float peaks[MAX_SCANS_PER_READING];
        uint16_t qc_bits = 0;
        while (attempts < MAX_SCANS_PER_READING) {
            for (int s = 0; s < SCANS_PER_READING && attempts < MAX_SCANS_PER_READING; s++, attempts++) {
                asv_result_t one = execute_asv_cycle();
                qc_bits |= one.qc;
                last_scan_points = one.points;
                // v5.7: only scans that passed their checks are averaged (was: any scan with 10+ points)
                if (one.points >= 10 && !(one.qc & QC_FAULT_MASK)) {
                    peaks[good_scans] = one.net_peak_ua;
                    peak_sum += one.net_peak_ua; snr_sum += one.snr; asv.peak_mv = one.peak_mv; good_scans++;
                }
                if (!isnan(one.cu_peak_ua)) { cu_sum += one.cu_peak_ua; cu_scans++; }
            }
            if (good_scans == 0) break;                         // hardware problem - don't keep scanning
            float est_ug = arsenic_ug_from_peak(peak_sum / good_scans);
            if (!arsenic_near_limit(est_ug, good_scans)) break;
            if (attempts < MAX_SCANS_PER_READING)
                Serial.printf("[ASV] %.1f ug/L is close to a limit after %d scan(s) - scanning again\n", est_ug, good_scans);
        }
        if (good_scans > 0) { asv.net_peak_ua = peak_sum / good_scans; asv.snr = snr_sum / good_scans; asv.points = good_scans; }
        if (cu_scans > 0) asv.cu_peak_ua = cu_sum / cu_scans;
        Serial.printf("[ASV] Averaged %d scan(s): net peak %.4f uA\n", good_scans, asv.net_peak_ua);
        float peak_current_ua = asv.net_peak_ua;

        // 5b. v5.7 reading QC: enough good scans, and the good scans agree with each other
        if (good_scans < QC_MIN_GOOD_SCANS) qc_bits |= QC_TOO_FEW_SCANS;
        if (good_scans >= 2) {
            float mean = peak_sum / good_scans, var = 0.0f;
            for (int i = 0; i < good_scans; i++) var += (peaks[i] - mean) * (peaks[i] - mean);
            float sd = sqrtf(var / (good_scans - 1));
            if (sd > fmaxf(QC_DISAGREE_UA, 0.25f * fabsf(mean))) qc_bits |= QC_SCANS_DISAGREE;
        }
        // faults seen only in scans that were then replaced by good ones do not fail the reading
        uint16_t reading_qc = qc_bits & ~(uint16_t)(QC_FAULT_MASK & ~(QC_TOO_FEW_SCANS | QC_SCANS_DISAGREE));
        bool qc_failed = (qc_bits & (QC_TOO_FEW_SCANS | QC_SCANS_DISAGREE)) != 0;
        if (qc_failed) reading_qc = qc_bits;                   // report what went wrong
        if (qc_failed) Serial.printf("[QC] Reading FAILED its checks (0x%04X) - sent as \"Test failed\", never as a low value.\n", qc_bits);

        // 6. Calibration: As (mg/L) = (Ip - intercept) / slope, with this node's calibration from the server
        //    (factory: (Ip - 0.0096) / 0.8563, identical to app/standards.py)
        float arsenic_mg_l = arsenic_ug_from_peak(peak_current_ua) / 1000.0f;

        // 7. Imp 15: on-device AquaNet-V3 (same model and safety rules as the server). v5.7: sensors that are
        //    not fitted (NAN) are "not measured": neutral network input and no rule, never a typical value.
        aquanet_result_t ai_res = aquanet_v3_predict_measured(arsenic_mg_l, ph, ec, turb, temp);
        if (qc_failed) Serial.println(F("[AQUANET V3] (test failed - the verdict below is not used)"));

        Serial.println(F("=================================================="));
        Serial.printf("[AQUANET V3] Predicted Safety: %s (Confidence: %.1f%%)\n",
            ai_res.predicted_class_name, ai_res.confidence_pct);
        Serial.printf("[AQUANET V3] Shannon Entropy: %.3f | High Uncertainty: %s\n",
            ai_res.entropy, ai_res.high_uncertainty ? "YES" : "NO");
        Serial.printf("[AQUANET V3] Reason: %s\n", ai_res.reason_code);
        Serial.println(F("=================================================="));

        // Package reading into Queue
        sensor_reading_t reading = {};            // zeroed, padding included (it is written to flash)
        reading.arsenic_mg_l = arsenic_mg_l;
        reading.ph = ph;
        reading.conductivity_us_cm = ec;
        reading.turbidity_ntu = turb;
        reading.temperature_c = temp;
        reading.peak_current_ua = peak_current_ua;
        reading.peak_mv = asv.peak_mv;
        reading.seq = next_reading_seq();
        reading.timestamp_unix = utc_now_or_zero();   // 0 = clock not synced; server then uses arrival time
        reading.predicted_class = (uint8_t)ai_res.predicted_class;
        reading.confidence_pct = ai_res.confidence_pct;
        reading.entropy = ai_res.entropy;
        reading.high_uncertainty = ai_res.high_uncertainty;
        reading.battery_pct = (int8_t)battery;
        reading.arsenic_species = reagent_pin >= 0 ? 2 : 1;
        reading.cal_tag = cal_tag_now;
        reading.cu_peak_ua = asv.cu_peak_ua;
        reading.qc_result = qc_failed ? 2 : 1;
        reading.good_scans = (uint8_t)good_scans;
        reading.qc_bits = reading_qc;
        if (first_result_ms == 0) {
            first_result_ms = millis();
            Serial.printf("[TIMING] First result %lu ms after power-on (%d scan attempt(s)).\n", (unsigned long)first_result_ms, attempts);
        }

        // v5.8: keep the arsenic part of the last scan (raw currents, before smoothing) as evidence for this reading
        if (TRACE_UPLOAD && last_scan_points >= 10) {
            int k = 0;
            for (int i = 0; i < last_scan_points && i < ASV_MAX_POINTS && asv_pot[i] <= VOLT_END_MV + 0.01f; i++, k++) {
                trace_pot[k] = asv_pot[i];
                trace_cur[k] = asv_raw[i];
            }
            trace_n = k;
            trace_seq = reading.seq;
            trace_utc = reading.timestamp_unix;
            trace_pending = true;
        }

        last_arsenic_ug = qc_failed ? NAN : arsenic_mg_l * 1000.0f;
        last_class = qc_failed ? -1 : (int)ai_res.predicted_class;
        last_reading_seq = reading.seq;
        last_reading_time = reading.timestamp_unix;
        if (xQueueSend(readingQueue, &reading, 2000 / portTICK_PERIOD_MS) != pdTRUE) {
            readings_dropped = readings_dropped + 1;   // not ++: deprecated on volatile in C++20
            Serial.println(F("[QUEUE] Telemetry queue full - reading dropped."));
        }

        digitalWrite(PIN_STATUS_LED, LOW);
        is_measuring = false;

        if (LOW_POWER_MODE) low_power_sleep_after_test(cycle_start);   // does not return when it sleeps

        // Wait until the next sampling cycle, running any blank / check standard requested on the /qc page
        uint32_t wait_start = millis();
        while (millis() - wait_start < SAMPLE_INTERVAL_MS) {
            if (qc_request) run_qc_measurement();
            vTaskDelay(1000 / portTICK_PERIOD_MS);
        }
    }
}

/* =====================================================================
 * Main System Setup & Task Allocation
 * ===================================================================== */
/* v5.8: boot self-test. Nothing here stops the node (a missing sensor is reported, and every scan is QC-checked
 * anyway); it tells the installer at once what the node can see, and the same facts are in /status.json. */
static bool i2c_present(uint8_t addr) {
    Wire.beginTransmission(addr);
    return Wire.endTransmission() == 0;
}
void boot_self_test() {
    selftest_adc_ok = i2c_present(ADS1115_ADDR);
    selftest_dac_ok = i2c_present(MCP4725_ADDR);
    selftest_fs_ok = fs_ok;
    uint32_t t0 = micros();
    aquanet_result_t probe = aquanet_v3_predict_measured(0.03f, 7.0f, 500.0f, 2.0f, 25.0f);
    selftest_infer_us = micros() - t0;
    uint32_t now_s = utc_now_or_zero();
    selftest_cal_age_days = (cal_saved_utc > 1700000000UL && now_s > cal_saved_utc) ? (int32_t)((now_s - cal_saved_utc) / 86400UL) : -1;
    Serial.println(F("[SELFTEST] ---- boot self-test ----"));
    Serial.printf("[SELFTEST] ADS1115 ADC (0x%02X): %s\n", ADS1115_ADDR, selftest_adc_ok ? "found" : "NOT FOUND - check SDA/SCL wiring and power");
    Serial.printf("[SELFTEST] MCP4725 DAC (0x%02X): %s\n", MCP4725_ADDR, selftest_dac_ok ? "found" : "NOT FOUND - no potential can be applied");
    Serial.printf("[SELFTEST] Offline storage: %s, %lu reading(s) waiting\n", fs_ok ? "LittleFS" : "RAM only", (unsigned long)offline_count());
    Serial.printf("[SELFTEST] Calibration: %s%s\n", cal_id, strcmp(cal_id, "factory") == 0 ? " (synthetic example - get this node calibrated)" : "");
    if (selftest_cal_age_days >= 0) Serial.printf("[SELFTEST] Calibration age: %ld day(s)%s\n", (long)selftest_cal_age_days, selftest_cal_age_days > 90 ? " - OVERDUE (90-day limit)" : "");
    Serial.printf("[SELFTEST] AquaNet-V3 inference: %lu us (probe verdict %s)\n", (unsigned long)selftest_infer_us, probe.predicted_class_name);
    Serial.printf("[SELFTEST] Scan evidence upload: %s\n", TRACE_UPLOAD ? "on" : "off");
    Serial.println(F("[SELFTEST] -------------------------"));
}

void setup() {
    Serial.begin(115200);
    delay(500);
    Serial.println(F("\n=================================================="));
    Serial.printf(" AquaSentry node firmware %s on %s\n", FIRMWARE_VERSION, BOARD_NAME);
    if (LOW_POWER_MODE) Serial.println(F(" Low-power mode: deep sleep between tests"));
    Serial.println(F("=================================================="));

    pinMode(PIN_STATUS_LED, OUTPUT);
    pinMode(PIN_BUBBLE_SENSE, INPUT);
    pinMode(PIN_STEPPER_STEP, OUTPUT);
    pinMode(PIN_STEPPER_DIR, OUTPUT);
    pinMode(PIN_STEPPER_ENABLE, OUTPUT);
    digitalWrite(PIN_STEPPER_ENABLE, HIGH); // Disabled by default
    gpio_hold_dis((gpio_num_t)PIN_STEPPER_ENABLE);   // released only after the level is set: no glitch
#if NEED_DEEP_SLEEP_HOLD
    gpio_deep_sleep_hold_dis();
#endif
    if (esp_sleep_get_wakeup_cause() == ESP_SLEEP_WAKEUP_TIMER) wake_count++;
    const int reagent_pin = PIN_REAGENT_PUMP;
    if (reagent_pin >= 0) {                      // dosing pump off (fit a 100k pull-down on the MOSFET gate too)
        pinMode((uint8_t)reagent_pin, OUTPUT);
        digitalWrite((uint8_t)reagent_pin, LOW);
        gpio_hold_dis((gpio_num_t)reagent_pin);
    }
    load_calibration();
    analogReadResolution(12);               // 0-4095 on every ESP32 variant (the bubble gate expects this)

    // Initialize I2C Bus
    Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN, 400000);

    load_settings();          // settings from the setup page override the defaults at the top
    offline_buffer_init();
    boot_self_test();
    if (!ota_enabled())
        Serial.println(F("[OTA] Web OTA (and settings over your network) are disabled until OTA_PASS is changed."));

    readingQueue = xQueueCreate(20, sizeof(sensor_reading_t));
    i2cMutex = xSemaphoreCreateMutex();

    // 16 KB: the TLS handshake for https uploads needs several KB of stack on top of the web server
    if (xTaskCreatePinnedToCore(TaskTelemetry, "TaskTelemetry", 16384, NULL, 1, NULL, TELEMETRY_CORE) != pdPASS)
        Serial.println(F("[SYSTEM] Could not start the telemetry task!"));
    // Higher priority for deterministic voltammetry timing
    if (xTaskCreatePinnedToCore(TaskSensors, "TaskSensors", 8192, NULL, 2, NULL, SENSOR_CORE) != pdPASS)
        Serial.println(F("[SYSTEM] Could not start the measurement task!"));

    Serial.printf("[SYSTEM] Tasks running (measurement on core %d).\n", SENSOR_CORE);
}

void loop() {
    // Loop task unused; tasks execute concurrently under FreeRTOS scheduler
    vTaskDelay(portMAX_DELAY);
}
