/* True once per `hours` (UTC clock), or once per boot while the clock is not set yet. */
static bool due_daily(uint32_t* last, uint32_t now_s, uint32_t hours) {
    if (now_s == 0) {
        if (*last != 0) return false;
        *last = 1;
        return true;
    }
    if (*last > 1 && now_s - *last < hours * 3600UL) return false;
    *last = now_s;
    return true;
}
