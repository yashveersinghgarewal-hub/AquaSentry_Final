/* =====================================================================
 * Imp 12: I2C 9-Pulse Bus Auto-Recovery Routine
 * ===================================================================== */
void recover_i2c_bus() {
    Serial.println(F("[I2C] Initiating 9-Pulse Bus Recovery Sequence..."));
    Wire.end();
    pinMode(I2C_SDA_PIN, INPUT_PULLUP);
    pinMode(I2C_SCL_PIN, OUTPUT_OPEN_DRAIN);

    // Pulse SCL 9 times to flush hung slave devices holding SDA low
    for (int i = 0; i < 9; i++) {
        digitalWrite(I2C_SCL_PIN, LOW);
        delayMicroseconds(5);
        digitalWrite(I2C_SCL_PIN, HIGH);
        delayMicroseconds(5);
        if (digitalRead(I2C_SDA_PIN) == HIGH) {
            Serial.printf("[I2C] SDA released on clock pulse %d\n", i + 1);
            break;
        }
    }

    // Generate STOP Condition: SCL high while SDA transitions from LOW to HIGH
    pinMode(I2C_SDA_PIN, OUTPUT_OPEN_DRAIN);
    digitalWrite(I2C_SDA_PIN, LOW);
    delayMicroseconds(5);
    digitalWrite(I2C_SCL_PIN, HIGH);
    delayMicroseconds(5);
    digitalWrite(I2C_SDA_PIN, HIGH);
    delayMicroseconds(5);

    // Re-initialize Wire in Master Mode at 400 kHz Fast-Mode
    Wire.begin(I2C_SDA_PIN, I2C_SCL_PIN, 400000);
    Serial.println(F("[I2C] Bus recovered successfully."));
}

/* =====================================================================
 * Imp 26: Peristaltic Stepper Pump & Anti-Set Relaxation Routine
 * ===================================================================== */
void step_pump(int steps, bool clockwise, int speed_us = 800) {
    digitalWrite(PIN_STEPPER_ENABLE, LOW); // Enable driver
    digitalWrite(PIN_STEPPER_DIR, clockwise ? HIGH : LOW);
    delayMicroseconds(10);

    for (int i = 0; i < steps; i++) {
        digitalWrite(PIN_STEPPER_STEP, HIGH);
        delayMicroseconds(speed_us);
        digitalWrite(PIN_STEPPER_STEP, LOW);
        delayMicroseconds(speed_us);
        if ((i & 255) == 255) vTaskDelay(1);   // let other tasks (and the watchdog) run during long purges
    }
    digitalWrite(PIN_STEPPER_ENABLE, HIGH); // Sleep driver to reduce heat
}

void pump_purge_and_relax(int purge_steps = 3200) {
    Serial.println(F("[PUMP] Running sample intake and purge cycle..."));
    // Forward purge: 3200 steps (approx 10 mL at 1/16 microstepping)
    step_pump(purge_steps, true, 600);
    delay(200);

    // Imp 26: Anti-set 1/4-turn (50 full steps / 800 microsteps) reverse relaxation
    Serial.println(F("[PUMP] Executing anti-set roller relaxation (1/4 turn reverse)..."));
    step_pump(200, false, 1200);
    Serial.println(F("[PUMP] Roller released from tubing pinch point."));
}

/* =====================================================================
 * Imp 27: Optical Dry-Run / Bubble Detection Gate
 * ===================================================================== */
bool check_chamber_liquid_presence() {
    int adc_val = analogRead(PIN_BUBBLE_SENSE);
    Serial.printf("[OPTICAL] Bubble/Fluid Sensor ADC: %d\n", adc_val);
    
    // Liquid in chamber refracts IR light away -> ADC drops below 2800
    // Air or bubbles reflect direct IR light -> ADC rises above 3200
    if (adc_val > 3000) {
        Serial.println(F("[SAFETY GATE] WARNING: Air bubble or dry chamber detected!"));
        return false;
    }
    return true;
}

/* =====================================================================
 * Imp 7 & 8: High-Precision Differential ASV Sweep Engine
 * ===================================================================== */
void dac_set_potential(float millivolts) {
    // MCP4725 12-bit DAC: 0 to 3.3V centered at virtual ground (1.65V = 2048)
    // Desired electrode potential V_we relative to virtual ground:
    float target_v = 1.65f + (millivolts / 1000.0f);
    if (target_v < 0.0f) target_v = 0.0f;
    if (target_v > 3.3f) target_v = 3.3f;
    uint16_t dac_val = (uint16_t)roundf((target_v / 3.3f) * 4095.0f);

    Wire.beginTransmission(MCP4725_ADDR);
    Wire.write(0x40); // "Write DAC register" command (3-byte form), normal power mode
    Wire.write((dac_val >> 4) & 0xFF);
    Wire.write((dac_val & 0x0F) << 4);
    Wire.endTransmission();
}

int16_t ads1115_read_differential() {
    // Read differential channels A0 (Working Electrode) - A1 (Reference/Virtual Ground)
    Wire.beginTransmission(ADS1115_ADDR);
    Wire.write(0x01); // Config register
    // OS=1 (start), MUX: A0-A1, PGA: +/-2.048V, MODE=1 single-shot (0x85; the old 0x84 meant continuous), DR: 128SPS
    Wire.write(0x85);
    Wire.write(0x83);
    Wire.endTransmission();

    delay(9); // Wait for conversion (128 SPS = 7.8 ms)

    Wire.beginTransmission(ADS1115_ADDR);
    Wire.write(0x00); // Conversion register
    Wire.endTransmission();

    Wire.requestFrom(ADS1115_ADDR, 2);
    if (Wire.available() == 2) {
        int16_t val = (Wire.read() << 8) | Wire.read();
        return val;
    }
    return 0;
}

typedef struct {
    float net_peak_ua;   // peak height above the fitted background
    float peak_mv;       // where the peak was found
    float snr;           // net peak / background noise
    int points;
} asv_result_t;

static float asv_pot[ASV_MAX_POINTS];
static float asv_raw[ASV_MAX_POINTS];
static float asv_smooth[ASV_MAX_POINTS];

/* 5-point Savitzky-Golay smoothing - same coefficients as app/signal_processing.py */
static void savgol5(const float* y, float* s, int n) {
    if (n < 5) { for (int i = 0; i < n; i++) s[i] = y[i]; return; }
    s[0] = (31.0f*y[0] + 9.0f*y[1] - 3.0f*y[2] - 5.0f*y[3] + 3.0f*y[4]) / 35.0f;
    s[1] = (9.0f*y[0] + 13.0f*y[1] + 12.0f*y[2] + 6.0f*y[3] - 5.0f*y[4]) / 35.0f;
    for (int i = 2; i < n - 2; i++)
        s[i] = (-3.0f*y[i-2] + 12.0f*y[i-1] + 17.0f*y[i] + 12.0f*y[i+1] - 3.0f*y[i+2]) / 35.0f;
    s[n-2] = (-5.0f*y[n-5] + 6.0f*y[n-4] + 12.0f*y[n-3] + 13.0f*y[n-2] + 9.0f*y[n-1]) / 35.0f;
    s[n-1] = (3.0f*y[n-5] - 5.0f*y[n-4] - 3.0f*y[n-3] + 9.0f*y[n-2] + 31.0f*y[n-1]) / 35.0f;
}

asv_result_t execute_asv_cycle() {
    asv_result_t res = {0.0f, PEAK_CENTER_MV, 0.0f, 0};
    Serial.println(F("[ASV] --- Starting ASV Anodic Stripping Cycle ---"));

    // Step 1: Electrochemical pre-cleaning pulse
    Serial.println(F("[ASV] Step 1: Applying +1.200V cleaning pulse (2.0s)..."));
    dac_set_potential(VOLT_CLEAN_MV);
    delay(VOLT_CLEAN_TIME_MS);

    // Step 2: Cathodic deposition
    Serial.println(F("[ASV] Step 2: Depositing at -1.100V (60.0s)..."));
    dac_set_potential(VOLT_DEP_MV);
    delay(VOLT_DEP_TIME_MS);

    // Step 3: Anodic sweep - record every point
    Serial.println(F("[ASV] Step 3: Sweeping -1100 -> -500 mV..."));
    int n = 0;
    for (float mv = VOLT_START_MV; mv <= VOLT_END_MV + 0.01f && n < ASV_MAX_POINTS; mv += VOLT_STEP_MV) {
        dac_set_potential(mv);
        delay(VOLT_STEP_WAIT_MS);
        int16_t raw_diff = ads1115_read_differential();
        // ADS1115 LSB = 62.5 uV at +/-2.048 V; transimpedance Rf = 100 kOhm -> 100 mV = 1 uA
        asv_pot[n] = mv;
        asv_raw[n] = (raw_diff * 0.0000625f / 100000.0f) * 1e6f;
        n++;
    }
    dac_set_potential(0.0f);   // back to rest
    res.points = n;
    if (n < 10) {
        Serial.println(F("[ASV] Too few points recorded - check the DAC/ADC wiring."));
        return res;
    }

    // Step 4: smooth, fit the background line away from the peak, subtract it
    savgol5(asv_raw, asv_smooth, n);
    double sx = 0, sy = 0, sxx = 0, sxy = 0;
    int m = 0;
    for (int i = 0; i < n; i++) {
        if (fabsf(asv_pot[i] - PEAK_CENTER_MV) > BASELINE_EXCLUDE_MV) {
            sx += asv_pot[i]; sy += asv_smooth[i];
            sxx += (double)asv_pot[i] * asv_pot[i]; sxy += (double)asv_pot[i] * asv_smooth[i];
            m++;
        }
    }
    float b_slope = 0.0f, b_icpt = 0.0f, noise = 1e-3f;
    if (m >= 2) {
        double den = m * sxx - sx * sx;
        b_slope = den != 0 ? (float)((m * sxy - sx * sy) / den) : 0.0f;
        b_icpt = (float)((sy - b_slope * sx) / m);
        double var = 0;
        for (int i = 0; i < n; i++) {
            if (fabsf(asv_pot[i] - PEAK_CENTER_MV) > BASELINE_EXCLUDE_MV) {
                double r = asv_smooth[i] - (b_slope * asv_pot[i] + b_icpt);
                var += r * r;
            }
        }
        noise = sqrtf((float)(var / (m > 2 ? m - 2 : 1)));
        if (noise < 1e-6f) noise = 1e-6f;
    }

    // Step 5: biggest net current inside the arsenic window
    float best = -1e9f;
    for (int i = 0; i < n; i++) {
        if (fabsf(asv_pot[i] - PEAK_CENTER_MV) <= PEAK_SEARCH_MV) {
            float net = asv_smooth[i] - (b_slope * asv_pot[i] + b_icpt);
            if (net > best) { best = net; res.peak_mv = asv_pot[i]; }
        }
    }
    res.net_peak_ua = best > 0.0f ? best : 0.0f;
    res.snr = res.net_peak_ua / noise;
    Serial.printf("[ASV] Done. Net peak %.4f uA at %.0f mV (SNR %.1f)\n", res.net_peak_ua, res.peak_mv, res.snr);
    return res;
}

