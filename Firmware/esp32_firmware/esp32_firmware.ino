/* Voltammetry parameters. These match the server software (app/standards.py, app/signal_processing.py)
 * and the MAS-G1 strip, whose arsenic stripping peak is at about -800 mV. If you use a different
 * electrode, recalibrate and change the values here AND in app/standards.py. */
#define VOLT_CLEAN_MV        1200.0f  // +1.200 V cleaning pulse (Imp 7)
#define VOLT_CLEAN_TIME_MS   2000     // 2.0 seconds
#define VOLT_DEP_MV         -1100.0f  // deposition: must be more negative than the -800 mV stripping peak
#define VOLT_DEP_TIME_MS     60000    // 60 seconds deposition
#define VOLT_START_MV       -1100.0f  // sweep -1100 -> -500 mV, same range as the software traces
#define VOLT_END_MV          -500.0f
#define VOLT_STEP_MV         5.0f     // 5 mV steps -> 121 points
#define VOLT_STEP_WAIT_MS    10       // 10 ms wait per step
#define ASV_MAX_POINTS       160

/* Peak finding and calibration - identical to the server */
#define PEAK_CENTER_MV       -800.0f  // app/standards.py PEAK_POTENTIAL_MV
#define PEAK_SEARCH_MV        60.0f   // peak searched in -860 .. -740 mV (SWEEP_WINDOW_MV)
#define BASELINE_EXCLUDE_MV  105.0f   // background line fitted outside -905 .. -695 mV
#define CAL_SLOPE_UA_PER_MGL  0.8563f // app/standards.py CALIBRATION_SLOPE
#define CAL_INTERCEPT_UA      0.0096f // app/standards.py CALIBRATION_INTERCEPT

#define SAMPLE_INTERVAL_MS   3600000UL // one full test per hour
#define SCANS_PER_READING    3          // scans per round: noise falls by sqrt(N) (3 scans = about 3.5 minutes)
#define MAX_SCANS_PER_READING 9         // borderline readings get up to 2 extra rounds (about 10.5 minutes)
#define RESCAN_Z             2.0f       // re-scan while within 2 standard errors of a limit

/* Arsenic from averaged peak current, in ug/L (same calibration as the server). */
static float arsenic_ug_from_peak(float peak_ua) {
    return peak_ua > CAL_INTERCEPT_UA ? (peak_ua - CAL_INTERCEPT_UA) / CAL_SLOPE_UA_PER_MGL * 1000.0f : 0.0f;
}

/* True if an arsenic estimate from n scans could plausibly be on the other side of a verdict edge:
 * 10 ug/L (IS 10500 / WHO limit), 20 ug/L (sensor LOD: above it = detected = Unsafe) or 150 ug/L (Hazardous).
 * Single-scan noise follows app/standards.py: 5 ug/L below 50, 7.5 up to 150, 15 above. */
static bool arsenic_near_limit(float ug, int n_scans) {
    static const float limits[3] = {10.0f, 20.0f, 150.0f};
    float sd = (ug < 50.0f ? 5.0f : (ug <= 150.0f ? 7.5f : 15.0f)) / sqrtf((float)n_scans);
    for (int i = 0; i < 3; i++)
        if (fabsf(ug - limits[i]) < RESCAN_Z * sd) return true;
    return false;
}

