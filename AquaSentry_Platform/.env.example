# AquaSentry Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit your actual .env file to version control.

# Google Gemini API Key (Required for AI Chatbot Agent)
# Obtain a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model used by the chat assistant (change if Google retires it)
GEMINI_MODEL=gemini-3.6-flash

# Write protection. When set, devices on the network must send this value in an X-API-Key header
# to add readings, import data or load demo data (the dashboard on this computer works without it).
# Put the same value in DEVICE_API_KEY in Firmware/esp32_firmware/esp32_firmware.ino.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
AQUASENTRY_API_KEY=

# Optional: POST every Unsafe / Hazardous alert as JSON to this URL (Slack/Discord/IFTTT webhook, etc.)
ALERT_WEBHOOK_URL=
# Optional: sign each delivery (Standard Webhooks: webhook-id / webhook-timestamp / webhook-signature
# headers, HMAC-SHA256). A "whsec_" + base64 value works with the Svix / standardwebhooks libraries.
# Generate one with:  python -c "import secrets,base64; print('whsec_'+base64.b64encode(secrets.token_bytes(32)).decode())"
ALERT_WEBHOOK_SECRET=
# Attempts per alert; network errors, 429 and 5xx are retried after 1 s, 4 s, 16 s ...
ALERT_WEBHOOK_ATTEMPTS=3

# /api/metrics (Prometheus text format). 0 = only this computer and holders of AQUASENTRY_API_KEY.
METRICS_PUBLIC=1

# Model for stored readings: v3 (trained, default) or v1 (original hand-built)
AQUANET_MODEL=v3

# Per-device keys (stronger than one shared key): from this computer run
#   curl -X POST http://localhost:8000/api/admin/devices/TANK-001/key
# and put the returned key in that node's setup page. A device with its own key must always use it.

# Rate limits per client IP per minute (0 = off)
RATE_LIMIT_READINGS_PER_MIN=240
RATE_LIMIT_IMPORT_PER_MIN=20
RATE_LIMIT_CHAT_PER_MIN=20

# How often hardware nodes report (minutes); used for online / late / offline status
DEVICE_EXPECTED_INTERVAL_MIN=60

# Where POST /api/admin/backup writes database copies (default AquaSentry_Platform/backups)
# AQUASENTRY_BACKUP_DIR=

# Database Configuration (Defaults to local SQLite)
# Leave unset to use AquaSentry_Platform/aquasentry.db wherever the server is started from.
# DATABASE_URL=sqlite:////absolute/path/to/aquasentry.db

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated or * for local testing)
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# System Operating Mode: demo | staging | production
AQUASENTRY_MODE=demo
