# AquaSentry Environment Configuration Template
# Copy this file to .env and provide your actual secrets.
# NEVER commit your actual .env file to version control.

# Google Gemini API Key (Required for AI Chatbot Agent)
# Obtain a free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model used by the chat assistant (change if Google retires it)
GEMINI_MODEL=gemini-3.6-flash

# Write protection. When set, devices on the network must send this value in an X-API-Key header
# to add readings, import data or load demo data (the dashboard on this computer works without it).
# Put the same value in DEVICE_API_KEY in Firmware/esp32_firmware/esp32_firmware.ino.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
AQUASENTRY_API_KEY=

# Optional: POST every Unsafe / Hazardous alert as JSON to this URL (Slack/Discord/IFTTT webhook, etc.)
ALERT_WEBHOOK_URL=

# Model for stored readings: v3 (trained, default) or v1 (original hand-built)
AQUANET_MODEL=v3

# Database Configuration (Defaults to local SQLite)
# Leave unset to use AquaSentry_Platform/aquasentry.db wherever the server is started from.
# DATABASE_URL=sqlite:////absolute/path/to/aquasentry.db

# Server Binding
HOST=127.0.0.1
PORT=8000

# CORS Allowed Origins (Comma-separated or * for local testing)
CORS_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# System Operating Mode: demo | staging | production
AQUASENTRY_MODE=demo
